.superpowers/
.research/

# Node
node_modules/
dist/
*.tsbuildinfo

# Rust
target/

# Tauri auto-generated (regenerated on every build)
app/src-tauri/gen/

# Tauri 2 plugin permission auto-gen (regenerated by tauri_plugin::Builder)
crates/*/permissions/autogenerated/
crates/*/permissions/schemas/

# Tesseract distribution copied in by CI before bundling (downloaded fresh per build).
# We keep the directory in git with a .placeholder so the tauri-build glob has
# at least one file to match in dev — the real binaries are ignored.
app/src-tauri/resources/tesseract/*
!app/src-tauri/resources/tesseract/.placeholder

# OS
.DS_Store
Thumbs.db
app/coverage/
