{
  "$schema": "https://schema.tauri.app/capabilities/2",
  "identifier": "capture-overlay",
  "description": "Permissions for capture overlay operations",
  "windows": ["capture-overlay"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:event:default",
    "snk-capture:default"
  ]
}
