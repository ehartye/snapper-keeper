{
  "$schema": "https://schema.tauri.app/capabilities/2",
  "identifier": "default",
  "description": "Default permissions for the library window",
  "windows": ["library", "capture-overlay", "capture-toolbar", "annotate", "clipboard-popup", "settings"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-fullscreen",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:path:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "snk-library:default",
    "snk-capture:default",
    "snk-annotate:default",
    "snk-clipboard:default",
    "snk-ocr:default",
    "snk-updater:default",
    "autostart:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$APPLOG" },
        { "path": "$APPLOG/**" }
      ]
    },
    "opener:allow-open-url"
  ]
}
