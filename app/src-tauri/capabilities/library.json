{
  "$schema": "https://schema.tauri.app/capabilities/2",
  "identifier": "library",
  "description": "Permissions for the library and capture toolbar windows",
  "windows": ["library", "capture-toolbar"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-fullscreen",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:path:default",
    "snk-library:allow-list-captures",
    "snk-library:allow-get-capture",
    "snk-library:allow-soft-delete-capture",
    "snk-library:allow-hard-delete-capture",
    "snk-library:allow-purge-trash",
    "snk-library:allow-set-capture-pinned",
    "snk-library:allow-list-tags",
    "snk-library:allow-create-tag",
    "snk-library:allow-update-tag",
    "snk-library:allow-delete-tag",
    "snk-library:allow-assign-tag",
    "snk-library:allow-remove-tag",
    "snk-library:allow-list-capture-tags",
    "snk-library:allow-get-setting",
    "snk-library:allow-set-setting",
    "snk-library:allow-search-library",
    "snk-library:allow-list-clipboard-items",
    "snk-library:allow-toggle-clipboard-pin",
    "snk-clipboard:allow-show-popup",
    "snk-capture:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url"
  ]
}
