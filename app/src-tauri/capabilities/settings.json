{
  "$schema": "https://schema.tauri.app/capabilities/2",
  "identifier": "settings",
  "description": "Permissions for settings and autostart operations",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-hide",
    "core:path:default",
    "core:event:default",
    "snk-library:allow-get-setting",
    "snk-library:allow-set-setting",
    "snk-library:allow-get-theme",
    "snk-clipboard:allow-detect-frontmost-app",
    "snk-updater:default",
    "autostart:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url"
  ]
}
